{
  "name": "story-time",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "convex dev --start 'vp dev --port 3000'",
    "dev:web": "vp dev --port 3000",
    "convex": "convex dev",
    "generate-routes": "tsr generate",
    "typegen": "wrangler types --env-file .dev.vars.example",
    "postinstall": "wrangler types --env-file .dev.vars.example && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/",
    "build": "vp build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vp preview"
  },
